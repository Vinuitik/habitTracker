{
  "id": "/today",
  "name": "HabitTracker",
  "short_name": "Habits",
  "description": "Daily habits, streaks and KPIs.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#161920",
  "background_color": "#0d0f14",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {"src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/android-chrome-maskable-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Today", "url": "/today", "icons": [{"src": "/android-chrome-192x192.png", "sizes": "192x192"}]},
    {"name": "New habit", "url": "/habits/add", "icons": [{"src": "/android-chrome-192x192.png", "sizes": "192x192"}]},
    {"name": "KPI dashboard", "url": "/kpis/dashboard", "icons": [{"src": "/android-chrome-192x192.png", "sizes": "192x192"}]}
  ]
}
