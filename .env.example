# REQUIRED, >=32 chars. App refuses to start without it. Generate: openssl rand -hex 32
JWT_SECRET=your-base64-secret-at-least-32-chars
MCP_TOKEN=your-long-random-mcp-token
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ── Backup + per-user Drive sync: Google Drive OAuth ────────────────────────
# Encrypted mongodump → Drive every BACKUP_INTERVAL_HOURS (mongo-backup), AND
# (as of the offline-PWA feature) the OAuth client javaapp uses when a user
# clicks "Connect Google Drive" for offline sync. Distinct from the
# GOOGLE_CLIENT_ID/SECRET above (that pair is the Java app's user *login*) —
# this pair only ever requests drive.file scope, never login/profile scope.
#
# CLIENT_ID/SECRET are reused from ObsidianOptimizer's OAuth client (same
# Google Cloud client) — but REFRESH_TOKEN below is the admin's own token for
# mongo-backup ONLY. Each habitTracker user who connects Drive for offline
# sync gets their OWN separate refresh token (stored per-user in Mongo, not
# here) via their own consent — this app-level GOOGLE_OAUTH_REFRESH_TOKEN is
# never touched by that flow.
# NOTE: clicking "Disconnect" in ObsidianOptimizer's Settings revokes this token
# at Google and silently kills these backups too. Reconnect there, then re-copy
# sync.refresh_token from its app_settings table into GOOGLE_OAUTH_REFRESH_TOKEN.
#
# IMPORTANT for the per-user Drive-connect flow specifically: if this OAuth
# client is still in Google Cloud Console "Testing" publishing status, ONLY
# the Google accounts listed as test users on the consent screen can complete
# the consent — every habitTracker user who wants to connect their own Drive
# needs to be added as a test user (or the app needs to be published).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_OAUTH_REFRESH_TOKEN=1//your-refresh-token

# Encrypts the dump before upload (gzip + AES-256-GCM, PBKDF2 310k iterations).
# REQUIRED — backup.py refuses to upload an unencrypted dump without it.
# LOSING THIS MEANS LOSING EVERY BACKUP: the passphrase is the only key, and it
# is not stored on Drive. Generate: openssl rand -hex 32
BACKUP_PASSPHRASE=generate-a-strong-passphrase
# Drive folder (find-or-created). The old service-account "HabitBackups" folder is
# invisible under drive.file, hence the v2 name.
BACKUP_FOLDER_NAME=HabitBackups v2
# Rolling backups retained on Drive; older ones are hard-deleted after each upload.
BACKUP_KEEP=5
BACKUP_INTERVAL_HOURS=12

# Trello MCP — get from https://trello.com/power-ups/admin
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token
# Set ONE of these to target the hourly cron (name is resolved at runtime, ID is used directly)
TRELLO_CRON_BOARD_NAME=My Board Name
TRELLO_CRON_BOARD_ID=

# Shared secret for the internal Trello API (mongo-backup:8092), sent by javaapp in X-Internal-Token.
# REQUIRED by javaapp and mongo-backup. Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=generate-a-long-random-token
# Host dir holding the Claude CLI login (mounted read-write into mongo-backup). Default ~/.claude;
# use an absolute path if your compose version does not expand ~.
CLAUDE_HOME=
