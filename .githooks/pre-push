#!/bin/sh
# On a push that updates master: run tests (failure blocks the push), then redeploy javaapp
# on this machine via scripts/deploy.sh (failure only warns — the code still reaches GitHub).
# Enabled by: git config core.hooksPath .githooks

pushing_master=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/master" ] && pushing_master=1
done
[ "$pushing_master" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: running tests..."
(cd habitTracker && ./mvnw test -q) || { echo "pre-push: tests failed — push blocked."; exit 1; }

./scripts/deploy.sh || echo "pre-push: DEPLOY FAILED (push continues) — see output above." >&2
exit 0
